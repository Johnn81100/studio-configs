{
  "env": {
    "NODE_EXTRA_CA_CERTS": "C:/Users/<utilisateur>/.claude/windows-certs.pem"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm start*)",
      "Bash(npm ls*)",
      "Bash(npm outdated*)",
      "mcp__plugin_github_github__get_me",
      "mcp__plugin_github_github__create_repository",
      "mcp__plugin_github_github__list_commits",
      "WebFetch",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(docker image ls*)",
      "Bash(docker volume ls*)",
      "Bash(docker network ls*)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker system df*)",
      "Bash(docker version)",
      "Bash(docker info)",
      "Bash(docker builder prune:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(~/Studio/studio-configs/settings.json)",
      "Edit(~/Studio/studio-configs/CLAUDE.md)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci)",
      "Bash(npm publish*)",
      "Bash(npm config *)",
      "Bash(npm token *)",
      "Bash(npm login)",
      "Bash(npx *)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(docker run *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker image prune*)",
      "Bash(docker container prune*)",
      "Bash(docker system prune*)",
      "Bash(docker network rm *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "c=$(cat); printf '%s' \"$c\" | grep -Eq 'studio-configs[\\\\/]+(CLAUDE\\.md|settings\\.json)|\\.claude[\\\\/]+(CLAUDE\\.md|settings(\\.local)?\\.json)' || exit 0; c=$(printf '%s' \"$c\" | sed -E 's#2?>&?[0-9]*[[:space:]]*/dev/null##g'); printf '%s' \"$c\" | grep -Eq '(>|\\btee\\b|\\bmv\\b|\\bcp\\b|\\brm\\b|\\bdd\\b|\\btruncate\\b|\\binstall\\b|\\bpython3?\\b|\\bnode\\b|\\bperl\\b|sed +-i)' || exit 0; printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Config protegee : ce fichier est deja en deny pour Edit. Y ecrire via Bash contournerait la regle. Presenter la modification a l utilisateur pour qu il l applique lui-meme.\"}}'",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Verification config protegee"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "c=$(cat); printf '%s' \"$c\" | jq -r '.tool_input.content // .tool_input.new_string // \"\"' | grep -q '—' && printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Tiret cadratin interdit. Remplacer selon le role reel dans la phrase : deux-points s il introduit, virgule s il oppose, parentheses s il incise, point si la phrase peut se couper. Ne pas substituer mecaniquement.\"}}'; exit 0",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Verification tiret cadratin"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "playwright@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "switchModelsOnFlag": false
}
