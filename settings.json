{
  "env": {
    "NODE_EXTRA_CA_CERTS": "C:/Users/<utilisateur>/.claude/windows-certs.pem"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(~/Studio/studio-configs/settings.json)",
      "Edit(~/Studio/studio-configs/CLAUDE.md)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci)",
      "Bash(npm publish*)",
      "Bash(npm config *)",
      "Bash(npm token *)",
      "Bash(npm login)",
      "Bash(npx *)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(docker run *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker image prune*)",
      "Bash(docker container prune*)",
      "Bash(docker system prune*)",
      "Bash(docker network rm *)"
    ],
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm start*)",
      "Bash(npm ls*)",
      "Bash(npm outdated*)",
      "mcp__plugin_github_github__get_me",
      "mcp__plugin_github_github__create_repository",
      "mcp__plugin_github_github__list_commits",
      "WebFetch",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(docker image ls*)",
      "Bash(docker volume ls*)",
      "Bash(docker network ls*)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker system df*)",
      "Bash(docker version)",
      "Bash(docker info)",
      "Bash(docker builder prune:*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "voiceEnabled": true,
  "model": "opus"
}
