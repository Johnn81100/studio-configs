{
  "env": {
    "NODE_EXTRA_CA_CERTS": "C:/Users/<utilisateur>/.claude/windows-certs.pem"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "mcp__plugin_github_github__get_me",
      "mcp__plugin_github_github__create_repository",
      "mcp__plugin_github_github__list_commits",
      "WebFetch",
      "Bash(docker builder prune:*)"
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "voiceEnabled": true,
  "model": "opus"
}
